<?xml version="1.0" encoding="utf-8"?>
<!--
  Client Center for Configuration Manager - WiX v5 package definition.
  Built by tools/Build-Installers.ps1 via:
    wix build ClientCenter.wxs ClientCenterUI.wxs -ext WixToolset.UI.wixext -bindpath PublishDir=... -d Version=1.1.17.0 -o ...
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Client Center for Configuration Manager"
      Manufacturer="drummachine24"
      Version="$(Version)"
      UpgradeCode="E8F3A2B1-5C4D-4E9F-A1B2-C3D4E5F60718"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">

    <SummaryInformation
        Description="Client Center for Configuration Manager"
        Manufacturer="drummachine24" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Client Center for Configuration Manager is already installed. Please uninstall it first if you need to install an older version."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Destination folder + optional Start Menu / Desktop shortcuts. -->
    <ui:WixUI Id="ClientCenter_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Client Center for Configuration Manager was installed successfully." />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Icon Id="ProductIcon" SourceFile="..\..\SCCMCliCtrWPF\SCCMCliCtrWPF\Icon16.ico" />

    <!-- Checked by default (Start Menu). Desktop opt-in matches Setup.exe. -->
    <Property Id="STARTMENUSHORTCUT" Value="1" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />

    <Feature Id="ProductFeature" Title="Client Center for Configuration Manager" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Client Center for Configuration Manager" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Client Center for Configuration Manager" />
    </StandardDirectory>

    <!-- Per-machine packages resolve DesktopFolder to the common/public desktop. -->
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- Harvest publish output; exclude portable PowerShell install helpers (ZIP-only). -->
      <Files Include="!(bindpath.PublishDir)\**">
        <Exclude Files="!(bindpath.PublishDir)\Install.cmd" />
        <Exclude Files="!(bindpath.PublishDir)\Install-ClientCenter.ps1" />
        <Exclude Files="!(bindpath.PublishDir)\Uninstall.cmd" />
        <Exclude Files="!(bindpath.PublishDir)\Uninstall-ClientCenter.ps1" />
      </Files>
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="B1C2D3E4-F5A6-4789-8ABC-DEF012345678" Condition="STARTMENUSHORTCUT">
      <Shortcut
          Id="StartMenuShortcut"
          Name="Client Center for Configuration Manager"
          Description="Client Center for Configuration Manager"
          Target="[INSTALLFOLDER]SCCMCliCtrWPF.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="ProductIcon" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="Software\drummachine24\ClientCenter"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="C2D3E4F5-A6B7-4890-9BCD-EF0123456789" Condition="DESKTOPSHORTCUT">
      <Shortcut
          Id="DesktopShortcutLink"
          Name="Client Center for Configuration Manager"
          Description="Client Center for Configuration Manager"
          Target="[INSTALLFOLDER]SCCMCliCtrWPF.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="ProductIcon" />
      <RegistryValue
          Root="HKLM"
          Key="Software\drummachine24\ClientCenter"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Package>
</Wix>
