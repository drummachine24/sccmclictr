<UserControl x:Class="AgentActionTools.CustomTools_SelfUpdate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="220">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
        <RibbonGroup Header="Self-Update" Name="_rgSelfUpdate">
            <RibbonButton Name="btCheckUpdate" Label="check"
                          ToolTip="Check GitHub for a newer Client Center release."
                          SmallImageSource="Images/Network_search.ico"
                          LargeImageSource="Images/Network_search.ico"
                          Click="btCheckUpdate_Click"/>
            <RibbonCheckBox Name="cbAutoCheck" Label="auto-check" IsChecked="False"
                            ToolTip="When enabled, Client Center checks GitHub for updates at startup. Off by default so launch is not delayed."
                            Checked="cbAutoCheck_Changed" Unchecked="cbAutoCheck_Changed"/>
        </RibbonGroup>
    </Grid>
</UserControl>
