<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <AssemblyName>Plugin_SelfUpdate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sccmclictrlib\sccmclictr.automation\sccmclictr.automation.csproj" />
    <ProjectReference Include="..\RuckZuck.Base\RuckZuck.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPFToolkit" Version="3.5.50211.1" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\**\*" />
    <Resource Include="Images\**\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="RZGet.exe" />
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
