<UserControl x:Class="ClientCenter.Controls.IntuneMdmLogsGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid>
        <DockPanel>
            <ToolBar DockPanel.Dock="Top" Height="32">
                <Button Name="bt_Reload" Click="bt_Reload_Click" ToolTip="Reload MDM event logs and log file list">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Height="16"/>
                        <TextBlock Margin="4,0,0,0" Text="Reload"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <TextBlock Name="tbStatus" VerticalAlignment="Center" Margin="6,0,0,0" Text="MDM diagnostics logs"/>
            </ToolBar>
            <DataGrid Name="dataGrid1" AutoGenerateColumns="False" IsReadOnly="True"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated}" MinWidth="140"/>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" MinWidth="50"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" MinWidth="70"/>
                    <DataGridTextColumn Header="Provider / Path" Binding="{Binding Provider}" MinWidth="160"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" MinWidth="240" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
