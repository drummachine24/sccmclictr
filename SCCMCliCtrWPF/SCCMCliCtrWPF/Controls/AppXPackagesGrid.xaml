<UserControl x:Class="ClientCenter.Controls.AppXPackagesGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Height="32">
                <ToolBar Name="toolBar1">
                    <Button ToolTip="Reload AppX packages (may take a while)" Name="bt_Reload" Click="bt_Reload_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico"/>
                            <TextBlock Margin="2,0,0,0">Reload AppX Packages</TextBlock>
                        </StackPanel>
                    </Button>
                    <Separator />
                </ToolBar>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <DataGrid AutoGenerateColumns="False" HorizontalAlignment="Stretch" Name="dataGrid1" VerticalAlignment="Stretch" IsReadOnly="True" SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Path=Name}" SortDirection="Ascending"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding Path=Version}"/>
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Path=Publisher}"/>
                        <DataGridTextColumn Header="Architecture" Binding="{Binding Path=Architecture}"/>
                        <DataGridCheckBoxColumn Header="Framework" Binding="{Binding Path=IsFramework}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Package Full Name" Binding="{Binding Path=PackageFullName}"/>
                        <DataGridTextColumn Header="Install Location" Binding="{Binding Path=InstallLocation}"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Name="miRemoveAppX" Header="Remove" Click="miRemoveAppX_Click">
                                <MenuItem.Icon>
                                    <Image Source="/SCCMCliCtrWPF;component/Images/Delete.ico" Height="24" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </DockPanel>
        </DockPanel>
    </Grid>
</UserControl>
