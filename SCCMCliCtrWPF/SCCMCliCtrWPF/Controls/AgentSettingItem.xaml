<UserControl x:Class="ClientCenter.AgentSettingItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="980">
    <Grid>
        <ScrollViewer Name="ScrollViewer1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="True">
            <Grid Name="spRoot" IsEnabled="False" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Client Information + Collections -->
                <DockPanel Grid.Column="0" LastChildFill="True" Margin="0,0,4,0">
                    <StackPanel DockPanel.Dock="Top" Name="spClientInfo">
                        <StackPanel Orientation="Horizontal" Height="28" Margin="0,0,0,4">
                            <Label Content="Client Information" FontWeight="Bold" FontSize="13" Padding="4,2,0,0" VerticalAlignment="Center"/>
                            <ToolBarPanel Height="24" Margin="8,0,0,0" VerticalAlignment="Center">
                                <ToolBar>
                                    <Image Name="imgReloadClientInfo" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20"
                                           MouseLeftButtonDown="imgReloadClientInfo_MouseLeftButtonDown" ToolTip="Reload client information, boundary names, and collections."/>
                                </ToolBar>
                            </ToolBarPanel>
                        </StackPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Operating System:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Name="tbOSCaption" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="OS Version / Build:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Name="tbOSVersionBuild" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="IP Address:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Name="tbIPAddress" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="Site:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Name="tbClientSite" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                            <Label Grid.Row="4" Grid.Column="0" Content="Boundary Group(s):" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                                   ToolTip="Resolved from SMS Provider using client BoundaryGroupCache IDs."/>
                            <TextBox Grid.Row="4" Grid.Column="1" Name="tbBoundaryGroups" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"
                                     ToolTip="Boundary group names when site lookup succeeds; otherwise IDs from the client cache."/>
                            <Label Grid.Row="5" Grid.Column="0" Content="Primary User:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Name="tbPrimaryUser" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                            <Label Grid.Row="6" Grid.Column="0" Content="Last Checked In:" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                                   ToolTip="Last heartbeat / DDR schedule trigger on the client."/>
                            <TextBox Grid.Row="6" Grid.Column="1" Name="tbLastCheckedIn" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                        </Grid>
                        <TextBlock Name="tbSiteLookupNote" Margin="8,2,4,6" FontSize="11" Foreground="#FF666666" TextWrapping="Wrap"/>
                        <Label Content="Collections" FontWeight="Bold" FontSize="13" Padding="4,2,0,4"/>
                    </StackPanel>
                    <DataGrid Name="dgCollections" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              MinHeight="160" Margin="4,0,4,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Collection ID" Binding="{Binding CollectionID}" Width="110"/>
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="1.2*" MinWidth="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <Border Grid.Column="1" Width="1" Background="#FFD0D0D0" Margin="0,4" HorizontalAlignment="Center"/>

                <!-- Right: Agent Settings -->
                <StackPanel Grid.Column="2" Name="spAgentSettings" HorizontalAlignment="Stretch" Margin="4,0,0,0">
                    <Label Content="Agent Settings" FontWeight="Bold" FontSize="13" Padding="4,2,0,6"/>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="stackPanel1" Orientation="Horizontal">
                        <Label Content="Site Code:" Height="28" Name="lSiteCode" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbSiteCode" Width="220" Margin="0,0,10,0" MaxLines="1" MaxLength="3" ToolTip="3Digit Site Code"/>
                        <ToolBarPanel Height="24" Name="toolBarPanel1">
                            <ToolBar Name="toolBar1">
                                <Image Name="imgSiteCode" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" MouseLeftButtonDown="imgSiteCode_MouseLeftButtonDown" ToolTip="Get the assigned Site Code."/>
                                <Image Name="imgSaveSiteCode" Source="/SCCMCliCtrWPF;component/Images/Save.ico" Stretch="Uniform" Width="20" Height="20" Margin="2,0,0,0" MouseLeftButtonDown="imgSaveSiteCode_MouseLeftButtonDown" ToolTip="Save the Site Code."/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spHTTPPort" Orientation="Horizontal" IsEnabled="False">
                        <Label Content="HTTP Port:" Height="28" Name="lHTTPPort" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbHTTPPort" Width="220" Margin="0,0,10,0" MaxLines="1" MaxLength="6" ToolTip="HTTP Port Number"/>
                        <ToolBarPanel Height="24" Name="toolBarPanel7">
                            <ToolBar Name="toolBar7">
                                <Image Name="imgGetHTTPPort" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Get the ConfigMgr Agent TCP Port." MouseLeftButtonDown="imgGetHTTPPort_MouseLeftButtonDown"/>
                                <Image Name="imgSetHTTPPort" Source="/SCCMCliCtrWPF;component/Images/Save.ico" Stretch="Uniform" Width="20" Height="20" Margin="2,0,0,0" ToolTip="Set HTTP Port." MouseLeftButtonDown="imgSetHTTPPort_MouseLeftButtonDown"/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spHTTPSPort" Orientation="Horizontal" IsEnabled="False">
                        <Label Content="HTTPS Port:" Height="28" Name="lHTTPSPort" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbHTTPSPort" Width="220" Margin="0,0,10,0" MaxLines="1" MaxLength="6" ToolTip="HTTPS Port Number"/>
                        <ToolBarPanel Height="24" Name="toolBarPanel8">
                            <ToolBar Name="toolBar8">
                                <Image Name="imgGetHTTPSPort" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Get the ConfigMgr Agent HTTPS Port." MouseLeftButtonDown="imgGetHTTPSPort_MouseLeftButtonDown"/>
                                <Image Name="imgSetHTTPSPort" Source="/SCCMCliCtrWPF;component/Images/Save.ico" Stretch="Uniform" Width="20" Height="20" Margin="2,0,0,0" ToolTip="Set HTTPS Port." MouseLeftButtonDown="imgSetHTTPSPort_MouseLeftButtonDown"/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="stackPanel2" Orientation="Horizontal">
                        <Label Content="Agent Version:" Height="28" Name="lAgentVersion" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbAgentVersion" Width="220" Margin="0,0,10,0" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                        <ToolBarPanel Height="24" Name="toolBarPanel2">
                            <ToolBar Name="toolBar2">
                                <Image Name="imgAgentVersion" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" MouseLeftButtonDown="imgAgentVersion_MouseLeftButtonDown" ToolTip="Get the ConfigMgr Agent Version."/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="stackPanel3" Orientation="Horizontal">
                        <Label Content="Management Point:" Height="28" Name="lMP" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbMP" Width="220" Margin="0,0,10,0" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                        <ToolBarPanel Height="24" Name="toolBarPanel3">
                            <ToolBar Name="toolBar3">
                                <Image Name="imgMP" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" MouseLeftButtonDown="imgMP_MouseLeftButtonDown" ToolTip="Get the assigned Management Point."/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="stackPanel4" Orientation="Horizontal">
                        <Label Content="Internet Management Point:" Height="28" Name="lInetMP" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbInetMP" Width="220" Margin="0,0,10,0" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                        <ToolBarPanel Height="24" Name="toolBarPanel4">
                            <ToolBar Name="toolBar4">
                                <Image Name="imgINetMP" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" MouseLeftButtonDown="imgINetMP_MouseLeftButtonDown" ToolTip="Get the assigned Internet Management Point."/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spProxyMP" Orientation="Horizontal">
                        <Label Content="Proxy Management Point:" Height="28" Name="lProxyMP" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbProxyMP" Width="220" Margin="0,0,10,0" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                        <ToolBarPanel Height="24" Name="toolBarPanel5">
                            <ToolBar Name="toolBar5">
                                <Image Name="imgProxyMP" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" MouseLeftButtonDown="imgProxyMP_MouseLeftButtonDown" ToolTip="Get the assigned Proxy Management Point."/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spDNSSuffix" Orientation="Horizontal">
                        <Label Content="DNS Suffix:" Height="28" Name="lDNSSuffix" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbDNSSuffix" Width="220" Margin="0,0,10,0" ToolTip="DNS Suffix (DNS Domain)"/>
                        <ToolBarPanel Height="24" Name="toolBarPanel6">
                            <ToolBar Name="toolBar6">
                                <Image Name="imgDNSSuffix" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" MouseLeftButtonDown="imgDNSSuffix_MouseLeftButtonDown" ToolTip="Get the DNS Suffix to locate a Management Point."/>
                                <Image Name="imgSaveDNSSuffix" Source="/SCCMCliCtrWPF;component/Images/Save.ico" Stretch="Uniform" Width="20" Height="20" MouseLeftButtonDown="imgSaveDNSSuffix_MouseLeftButtonDown" Margin="2,0,0,0" ToolTip="Save the DNS Suffix."/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spSLP" Orientation="Horizontal">
                        <Label Content="Server Locator Point:" Height="28" Name="lSLP" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbSLP" Width="220" Margin="0,0,10,0" ToolTip="Server Locator Point (on ConfigMgr it's the MP)"/>
                        <ToolBarPanel Height="24" Name="tbpSLP">
                            <ToolBar Name="toolBSLP">
                                <Image Name="imgGetSLP" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Get the assigned Server Locator Point" MouseLeftButtonDown="imgGetSLP_MouseLeftButtonDown"/>
                                <Image Name="imgSaveSLP" Source="/SCCMCliCtrWPF;component/Images/Save.ico" Stretch="Uniform" Width="20" Height="20" Margin="2,0,0,0" ToolTip="Save the Server Locator Point." MouseLeftButtonDown="imgSaveSLP_MouseLeftButtonDown"/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spGUID" Orientation="Horizontal">
                        <Label Content="Unique Identifier (GUID):" Height="28" Name="lGUID" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbGUID" Width="220" Margin="0,0,10,0" ToolTip="Unique Identifier (GUID)" IsReadOnly="True" Background="#FFF4F4F4"/>
                        <ToolBarPanel Height="24" Name="tbpGUID">
                            <ToolBar Name="toolBGUID">
                                <Image Name="imgGetGUID" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Get the Agent GUID." MouseLeftButtonDown="imgGetGUID_MouseLeftButtonDown"/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spLogPath" Orientation="Horizontal">
                        <Label Content="Agent Log Path:" Height="28" Name="lLogPath" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbLogPath" Width="220" Margin="0,0,10,0" ToolTip="Agent log path." IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                        <ToolBarPanel Height="24" Name="tbpLogPath">
                            <ToolBar Name="toolBLogPath">
                                <Image Name="imgGetLogPath" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Get the Agent Log path." MouseLeftButtonDown="imgGetLogPath_MouseLeftButtonDown"/>
                                <Image Name="imgOpenLogPath" Source="/SCCMCliCtrWPF;component/Images/Browse.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Open the Agent Log path." MouseLeftButtonDown="imgOpenLogPath_MouseLeftButtonDown" Margin="2,0,0,0"/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spSetupPath" Orientation="Horizontal">
                        <Label Content="CCMSetup Path:" Height="28" Name="lSetupPath" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbSetupPath" Width="220" Margin="0,0,10,0" ToolTip="CCMSetup path." IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                        <ToolBarPanel Height="24" Name="tbpSetupPath">
                            <ToolBar Name="toolBSetupPath">
                                <Image Name="imgOpenSetupPath" Source="/SCCMCliCtrWPF;component/Images/Browse.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Open the CCMSetup path." Margin="2,0,0,0" MouseLeftButtonDown="imgOpenSetupPath_MouseLeftButtonDown"/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spCachePath" Orientation="Horizontal">
                        <Label Content="Cache Path:" Height="28" Name="lCachePath" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <TextBox Height="23" Name="tbCachePath" Width="220" Margin="0,0,10,0" ToolTip="Package Cache path."/>
                        <ToolBarPanel Height="24" Name="tbpCachePath">
                            <ToolBar Name="toolBCachePath">
                                <Image Name="imgGetCachePath" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Get the Agent Cache path." MouseLeftButtonDown="imgGetCachePath_MouseLeftButtonDown"/>
                                <Image Name="imgOpenCachePath" Source="/SCCMCliCtrWPF;component/Images/Browse.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Open the Cache path." Margin="2,0,0,0" MouseLeftButtonDown="imgOpenCachePath_MouseLeftButtonDown"/>
                                <Image Name="imgSaveCachepath" Source="/SCCMCliCtrWPF;component/Images/Save.ico" Stretch="Uniform" Width="20" Height="20" Margin="2,0,0,0" ToolTip="Save the new Cache Path." MouseLeftButtonDown="imgSaveCachepath_MouseLeftButtonDown"/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                    <StackPanel Height="32" HorizontalAlignment="Left" Name="spAutoSite" Orientation="Horizontal">
                        <Label Content="Auto Site Assignment:" Height="28" Name="lAutoSite" Width="180" Margin="2,0,10,0" HorizontalContentAlignment="Right"/>
                        <CheckBox Name="cbAutoSite" Margin="0,10,2,0" ToolTip="Automatically assign a Site code on next agent restart."/>
                        <Label Content="(Auto Site Discovery)" Height="28" Margin="2,0,8,0" ClipToBounds="True"/>
                        <ToolBarPanel Height="24" Name="tbpAutoSite">
                            <ToolBar Name="toolBAutoSite">
                                <Image Name="imgGetAutoSite" Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Stretch="Uniform" Width="20" Height="20" ToolTip="Get Auto Site Assignment." MouseLeftButtonDown="imgGetAutoSite_MouseLeftButtonDown"/>
                                <Image Name="imgSaveAutoSite" Source="/SCCMCliCtrWPF;component/Images/Save.ico" Stretch="Uniform" Width="20" Height="20" Margin="2,0,0,0" ToolTip="Save Auto Site Assignment." MouseLeftButtonDown="imgSaveAutoSite_MouseLeftButtonDown"/>
                            </ToolBar>
                        </ToolBarPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
