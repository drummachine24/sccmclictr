<UserControl x:Class="ClientCenter.Controls.ClientInformationGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="700">
    <Grid>
        <DockPanel LastChildFill="True" Margin="8">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Height="32" Margin="0,0,0,6">
                    <Label Content="Client Information" FontWeight="Bold" FontSize="13" Padding="4,2,0,0" VerticalAlignment="Center"/>
                    <ToolBarPanel Height="24" Margin="8,0,0,0" VerticalAlignment="Center">
                        <ToolBar>
                            <Button Name="bt_Reload" Click="bt_Reload_Click" ToolTip="Reload client information, boundary names, and collections.">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/SCCMCliCtrWPF;component/Images/shell32.dll_I0017_0409.ico" Height="16"/>
                                    <TextBlock Margin="4,0,0,0" Text="Reload" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </ToolBar>
                    </ToolBarPanel>
                </StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="Operating System:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Name="tbOSCaption" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                    <Label Grid.Row="1" Grid.Column="0" Content="OS Version / Build:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Name="tbOSVersionBuild" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                    <Label Grid.Row="2" Grid.Column="0" Content="IP Address:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Name="tbIPAddress" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                    <Label Grid.Row="3" Grid.Column="0" Content="Site:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Name="tbClientSite" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                    <Label Grid.Row="4" Grid.Column="0" Content="Boundary Group(s):" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                           ToolTip="Resolved from SMS Provider using client BoundaryGroupCache IDs."/>
                    <TextBox Grid.Row="4" Grid.Column="1" Name="tbBoundaryGroups" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"
                             ToolTip="Boundary group names when site lookup succeeds; otherwise IDs from the client cache."/>
                    <Label Grid.Row="5" Grid.Column="0" Content="Primary User:" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Name="tbPrimaryUser" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                    <Label Grid.Row="6" Grid.Column="0" Content="Last Checked In:" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                           ToolTip="Last heartbeat / DDR schedule trigger on the client."/>
                    <TextBox Grid.Row="6" Grid.Column="1" Name="tbLastCheckedIn" Margin="4,2" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="#FFF4F4F4"/>
                </Grid>
                <TextBlock Name="tbSiteLookupNote" Margin="8,2,4,8" FontSize="11" Foreground="#FF666666" TextWrapping="Wrap"/>
                <Label Content="Collections" FontWeight="Bold" FontSize="13" Padding="4,2,0,4"/>
            </StackPanel>
            <DataGrid Name="dgCollections" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      MinHeight="180" Margin="4,0,4,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Collection ID" Binding="{Binding CollectionID}" Width="120"/>
                    <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="1.2*" MinWidth="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
